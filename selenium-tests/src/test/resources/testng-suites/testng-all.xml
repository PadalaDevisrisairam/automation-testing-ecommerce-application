<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  testng-all.xml — runs the full test suite: UI (Selenium) + API (REST Assured)

  Usage:
    mvn test                          (default profile)
    mvn test -P testng
-->
<suite name="ECommerce Full TestNG Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.ecommerce.automation.reports.ExtentReportListener"/>
    </listeners>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  API Tests (REST Assured — no browser needed)  -->
    <!-- ═══════════════════════════════════════════════ -->

    <test name="Auth API Tests">
        <classes>
            <class name="com.ecommerce.automation.api.tests.AuthApiTest"/>
        </classes>
    </test>

    <test name="Products API Tests">
        <classes>
            <class name="com.ecommerce.automation.api.tests.ProductsApiTest"/>
        </classes>
    </test>

    <test name="Cart API Tests">
        <classes>
            <class name="com.ecommerce.automation.api.tests.CartApiTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  UI Tests (Selenium WebDriver)                 -->
    <!-- ═══════════════════════════════════════════════ -->

    <test name="Login Tests">
        <classes>
            <class name="com.ecommerce.automation.testng.LoginTest"/>
        </classes>
    </test>

    <test name="Products Tests">
        <classes>
            <class name="com.ecommerce.automation.testng.ProductsTest"/>
        </classes>
    </test>

    <test name="Cart Tests">
        <classes>
            <class name="com.ecommerce.automation.testng.CartTest"/>
        </classes>
    </test>

</suite>
